# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id (in a private chat with the bot it is the chat id).
# Required: the bot refuses to start without it.
ALLOWED_CHAT_ID=
# Destination folder on the reMarkable (created if missing)
REMARKABLE_FOLDER=/Inbox
# rmapi auth file. Secret: never commit it.
RMAPI_CONFIG=./.secrets/rmapi.conf
# Path to the rmapi binary (pnpm rmapi:install puts it in ./bin)
RMAPI_BIN=./bin/rmapi
