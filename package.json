{
  "name": "tweet2remarkable",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Telegram bot: share a post from X, a link or a PDF, and it lands on your reMarkable.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "send": "tsx src/cli.ts",
    "rmapi:install": "sh scripts/install-rmapi.sh",
    "rmapi:pair": "mkdir -p .secrets && RMAPI_CONFIG=${RMAPI_CONFIG:-./.secrets/rmapi.conf} ./bin/rmapi ls /",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
